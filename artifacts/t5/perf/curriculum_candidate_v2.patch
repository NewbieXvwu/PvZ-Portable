+    def test_length_group_history_and_rng_resume_exactly(self):
+        state = initial_state(LENGTH_TASKS)
+        observe(state, outcomes("day_1_0", [False] * 16 + [True] * 16), LENGTH_SETTINGS)
+        rng = random.Random(88)
+        rng.random()
+        saved = rng.getstate()
