    "learning_rate": 0.0001,
    "ppo_epochs": 2,
    "sequence_length": 128,
    "minibatch_chunks": 2,
    "clip_epsilon": 0.2,
    "gae_lambda": 0.95,
    "value_coefficient": 0.5,
    "entropy_coefficient": 0.01,
    "attention_backend": "dense",
    "target_kl": 0.03
