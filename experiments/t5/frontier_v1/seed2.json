      2000,
      25000,
      125000,
      250000,
      375000,
      500000
    ]
  },
  "runtime": {
    "workers": 2,
    "worker_threads": 1,
    "worker_device": "cpu",
    "update_device": "cuda",
    "max_actions": 4000,
    "cudnn_tf32": false,
