{
  "schema_version": 1,
  "experiment_id": "mainline_frontier_v1_seed2",
  "purpose": "Explicit 0.2-0.8 frontier heuristic; global priority blended with terrain/cap-balanced25% floor. All original30 training tasks and seeds remain; original evaluation unchanged. Headless single-GRU256 reference, no auxiliary prediction. Useful short segments before full budget.",
